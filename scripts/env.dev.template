# AI Benchmark Pipeline — Development Environment Configuration
# Generated by ai-bench-installer dev-setup.
# Install dir: {{INSTALL_DIR}}
#
# The explicit absolute database path prevents dev from accidentally
# writing to a CWD-relative database (which could collide with production
# if you happen to run from C:\ai-benchmark).

# ── Core Pipeline ──
AI_BENCH_DATABASE_URL=sqlite+aiosqlite:///{{INSTALL_DIR}}/ai_benchmark.db
AI_BENCH_LOG_LEVEL=DEBUG
AI_BENCH_LOG_FORMAT=console
# AI_BENCH_LOG_DIR=  # Set to a directory path to enable file logging

# ── Claude CLI ──
# CLAUDE_SESSION=  # Set to a session ID to resume an authorized OAuth session

# ── API Keys (optional but recommended) ──
AI_BENCH_GITHUB_TOKEN=
AI_BENCH_SEMANTIC_SCHOLAR_API_KEY=
