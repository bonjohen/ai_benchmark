# AI Benchmark Pipeline — Production Environment Configuration
#
# Generated by ai-bench-installer for instance "{{INSTANCE_NAME}}".
# Install dir: {{INSTALL_DIR}}
#
# ── Setting Precedence ──
# 1. Environment variable (e.g., set AI_BENCH_DATABASE_URL=...)
# 2. This .env file
# 3. Built-in default in PipelineSettings / EvalSettings
#
# All pipeline settings use the AI_BENCH_ prefix.
# All eval settings use the AI_BENCH_EVAL_ prefix.
# Both PipelineSettings and EvalSettings load from this file with extra="ignore",
# so all settings can coexist in one .env file.

# ── Core Pipeline ──
AI_BENCH_DATABASE_URL=sqlite+aiosqlite:///{{INSTALL_DIR}}/data/ai_benchmark.db
AI_BENCH_LOG_LEVEL=INFO
AI_BENCH_LOG_FORMAT=console
AI_BENCH_REQUEST_TIMEOUT=30
AI_BENCH_MAX_CONCURRENCY=5
AI_BENCH_RETRY_ATTEMPTS=3

# ── API Keys (optional but recommended) ──
AI_BENCH_GITHUB_TOKEN=
AI_BENCH_SEMANTIC_SCHOLAR_API_KEY=

# ── HTTP Proxy (optional) ──
# AI_BENCH_PROXY_URL=

# ── Eval Pipeline ──
AI_BENCH_EVAL_DATABASE_URL=sqlite+aiosqlite:///{{INSTALL_DIR}}/data/ai_benchmark.db
AI_BENCH_EVAL_ARTIFACT_STORAGE_PATH={{INSTALL_DIR}}/artifacts
AI_BENCH_EVAL_API_HOST=127.0.0.1
AI_BENCH_EVAL_API_PORT={{API_PORT}}
AI_BENCH_EVAL_MAX_CONCURRENT_ITEMS=5
AI_BENCH_EVAL_DEFAULT_EXECUTION_MODE=sequential
AI_BENCH_EVAL_RUN_TIMEOUT_SECONDS=3600
AI_BENCH_EVAL_ITEM_TIMEOUT_SECONDS=120
AI_BENCH_EVAL_RETRY_FAILED_ITEMS=2
AI_BENCH_EVAL_ARTIFACT_RETENTION_DAYS=90
AI_BENCH_EVAL_ARTIFACT_MAX_PER_RUN=20
