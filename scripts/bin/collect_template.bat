@echo off
:: AI Benchmark — Collection runner (single-writer safe)
:: Generated by ai-bench-installer. Do not edit manually.
:: Stops the eval server before collection, restarts afterward.
:: Reads config from {{INSTALL_DIR}}\config\.env

setlocal enabledelayedexpansion

set INSTALL_DIR={{INSTALL_DIR}}
set ENV_FILE=%INSTALL_DIR%\config\.env
set PYTHON=%INSTALL_DIR%\venv\Scripts\python.exe
set AI_BENCH_ENV_FILE=%ENV_FILE%

:: Load environment from .env
if exist "%ENV_FILE%" (
    for /f "usebackq tokens=1,* delims==" %%A in ("%ENV_FILE%") do (
        set "LINE=%%A"
        if not "!LINE:~0,1!"=="#" (
            if not "%%A"=="" set "%%A=%%B"
        )
    )
)

:: Ensure logs directory exists
if not exist "%INSTALL_DIR%\logs" mkdir "%INSTALL_DIR%\logs"

:: Timestamped log file
for /f "tokens=2 delims==" %%I in ('wmic os get localdatetime /value') do set dt=%%I
set LOGFILE=%INSTALL_DIR%\logs\collect_{{LOG_PREFIX}}_%dt:~0,8%_%dt:~8,6%.log

cd /d %INSTALL_DIR%

:: Stop eval server before collection (single-writer: only collector writes to DB)
echo [%date% %time%] Stopping eval server for collection >> "%LOGFILE%" 2>&1
taskkill /f /fi "IMAGENAME eq python.exe" /fi "WINDOWTITLE eq *eval*serve*" >nul 2>&1
:: Also kill by command line match for background servers
for /f "tokens=2" %%P in ('wmic process where "commandline like '%%eval serve%%' and commandline like '%%ai_benchmark%%'" get processid 2^>nul ^| findstr /r "[0-9]"') do (
    taskkill /f /pid %%P >nul 2>&1
)
timeout /t 2 /nobreak >nul

echo [%date% %time%] Starting collection >> "%LOGFILE%" 2>&1
%PYTHON% -m ai_benchmark.cli collect >> "%LOGFILE%" 2>&1
set EXIT_CODE=%ERRORLEVEL%
echo [%date% %time%] Collection finished (exit code %EXIT_CODE%) >> "%LOGFILE%" 2>&1

:: Restart eval server
echo [%date% %time%] Restarting eval server >> "%LOGFILE%" 2>&1
start "" /min %PYTHON% -m ai_benchmark.cli eval serve
echo [%date% %time%] Server restart initiated >> "%LOGFILE%" 2>&1

exit /b %EXIT_CODE%
