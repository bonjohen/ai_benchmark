# AI Benchmark Pipeline — Production Environment Configuration
#
# Copy this file to C:\ai-benchmark\config\.env and fill in values.
#
# Production architecture:
#   Install dir : C:\ai-benchmark
#   Virtual env : C:\ai-benchmark\venv  (wheel-based, non-editable install)
#   Database    : C:\ai-benchmark\data\ai_benchmark.db
#   Bin scripts : C:\ai-benchmark\bin\  (use venv Python)
#   Config      : C:\ai-benchmark\config\.env  (this file)
#
# Dev environment uses a separate .env at C:\Projects\ai_benchmark\.env
# (see scripts/env.dev.template). The two environments are isolated by
# the production venv — dev changes do not affect production until deployed.

# ── Core Pipeline ──
AI_BENCH_DATABASE_URL=sqlite+aiosqlite:///C:/ai-benchmark/data/ai_benchmark.db
AI_BENCH_LOG_LEVEL=INFO
AI_BENCH_LOG_FORMAT=console
AI_BENCH_REQUEST_TIMEOUT=30
AI_BENCH_MAX_CONCURRENCY=5
AI_BENCH_RETRY_ATTEMPTS=3

# ── API Keys (optional but recommended) ──
AI_BENCH_GITHUB_TOKEN=
AI_BENCH_SEMANTIC_SCHOLAR_API_KEY=

# ── HTTP Proxy (optional) ──
# AI_BENCH_PROXY_URL=

# ── Eval Pipeline ──
AI_BENCH_EVAL_DATABASE_URL=sqlite+aiosqlite:///C:/ai-benchmark/data/ai_benchmark.db
AI_BENCH_EVAL_ARTIFACT_STORAGE_PATH=C:/ai-benchmark/artifacts
AI_BENCH_EVAL_API_HOST=127.0.0.1
AI_BENCH_EVAL_API_PORT=8100
AI_BENCH_EVAL_MAX_CONCURRENT_ITEMS=5
AI_BENCH_EVAL_DEFAULT_EXECUTION_MODE=sequential
AI_BENCH_EVAL_RUN_TIMEOUT_SECONDS=3600
AI_BENCH_EVAL_ITEM_TIMEOUT_SECONDS=120
AI_BENCH_EVAL_RETRY_FAILED_ITEMS=2
AI_BENCH_EVAL_ARTIFACT_RETENTION_DAYS=90
AI_BENCH_EVAL_ARTIFACT_MAX_PER_RUN=20
